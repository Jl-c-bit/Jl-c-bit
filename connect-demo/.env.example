# Copy this file to .env and fill in each value. Never commit .env.

# PLACEHOLDER: your platform's secret key, from https://dashboard.stripe.com/apikeys
# Use a test key (sk_test_...) while developing.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# PLACEHOLDER: signing secret for the THIN event destination (connected-account v2 events).
# Locally, `stripe listen --thin-events ... --forward-thin-to localhost:4242/webhooks/connect` prints it.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_REPLACE_ME

# PLACEHOLDER: signing secret for the SNAPSHOT webhook endpoint (subscription/billing events).
# Locally, `stripe listen --events ... --forward-to localhost:4242/webhooks/billing` prints it.
STRIPE_BILLING_WEBHOOK_SECRET=whsec_REPLACE_ME

# PLACEHOLDER: a RECURRING price on your PLATFORM account that sellers subscribe to.
# Create a product with a monthly price at https://dashboard.stripe.com/products and copy its price_ ID.
PRICE_ID=price_REPLACE_ME

# Optional
PORT=4242
BASE_URL=http://localhost:4242
# Platform fee per storefront sale, in cents (123 = $1.23).
APPLICATION_FEE_CENTS=123
